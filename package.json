{
  "name": "hypaware",
  "version": "1.29.0",
  "type": "module",
  "description": "HypAware: AI agent observability with a plugin kernel. Records Claude Code, Codex, OTEL, and raw AI gateway traffic into one queryable history, kept on your machine or shared across machines and teams.",
  "bin": {
    "hypaware": "./bin/hypaware.js",
    "hyp": "./bin/hypaware.js"
  },
  "types": "./src/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/core/index.d.ts",
      "import": "./src/core/index.js"
    },
    "./core": {
      "types": "./src/core/index.d.ts",
      "import": "./src/core/index.js"
    },
    "./core/observability": {
      "types": "./types/core/observability/index.d.ts",
      "import": "./src/core/observability/index.js"
    },
    "./core/sinks": {
      "types": "./types/core/sinks/index.d.ts",
      "import": "./src/core/sinks/index.js"
    },
    "./core/query": {
      "types": "./types/core/query/index.d.ts",
      "import": "./src/core/query/index.js"
    },
    "./core/search": {
      "types": "./types/core/search/index.d.ts",
      "import": "./src/core/search/index.js"
    },
    "./core/search/types.js": {
      "types": "./src/core/search/types.d.ts"
    },
    "./core/util": {
      "types": "./types/core/util/index.d.ts",
      "import": "./src/core/util/index.js"
    },
    "./core/reports": {
      "types": "./types/core/reports/render.d.ts",
      "import": "./src/core/reports/render.js"
    },
    "./integration": {
      "types": "./src/core/cli/integration.d.ts",
      "import": "./src/core/cli/integration.js"
    },
    "./tui": {
      "types": "./types/core/cli/tui/index.d.ts",
      "import": "./src/core/cli/tui/index.js"
    }
  },
  "imports": {
    "#core/observability": "./src/core/observability/index.js"
  },
  "files": [
    "bin/",
    "src/",
    "hypaware-core/",
    "types/",
    "hypaware-plugin-kernel-types.d.ts"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "node scripts/run-tests.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "bench:icebird-real": "node --expose-gc benchmarks/icebird-real-data.mjs",
    "bench:normal-cpu": "node benchmarks/normal-usage-cpu.mjs",
    "prepare": "npm run build:types",
    "smoke": "node ./hypaware-core/smoke/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1120.0",
    "@aws-sdk/credential-provider-ini": "3.973.15",
    "hyparquet": "1.29.2",
    "hyparquet-compressors": "1.1.1",
    "hypgrep": "0.5.1",
    "hysnappy": "1.1.1",
    "icebird": "0.8.26",
    "marked": "18.0.11",
    "squirreling": "0.16.3"
  },
  "optionalDependencies": {
    "hyparquet-writer": "0.16.8",
    "hypvector": "0.2.2"
  },
  "overrides": {
    "icebird": {
      "hyparquet": "1.29.2",
      "hyparquet-writer": "0.16.8"
    },
    "hypgrep": {
      "hyparquet": "1.29.2",
      "hyparquet-writer": "0.16.8"
    }
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "typescript": "7.0.2"
  }
}
